[flake8]
# Максимальная длина строки
max-line-length = 120

# Что проверяем: синтаксические ошибки, неиспользуемые импорты и переменные,
# подозрительные сравнения и т.п. Косметика (отступы, пробелы) не блокирует CI.
select = E9,F63,F7,F82,F401,F811,F841,E501,E722,W291,W293

exclude =
    .git,
    .venv,
    venv,
    __pycache__,
    */migrations/*,
    staticfiles,
    media

# Миграции Django генерируются автоматически — их стиль не проверяем
per-file-ignores =
    config/settings.py:E501

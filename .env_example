# Скопируйте этот файл в .env и заполните значения:
#   Windows:  copy .env_example .env
#   Linux/macOS:  cp .env_example .env
#
# При запуске через docker compose значения POSTGRES_HOST и REDIS_HOST
# заменяются на имена сервисов (db и redis) автоматически — см. docker-compose.yml.
# Значения localhost ниже нужны для локального запуска без Docker.

# --- Django ---
SECRET_KEY=
DEBUG=True

# --- PostgreSQL ---
POSTGRES_DB=skillport
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Redis (брокер и result backend Celery) ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=

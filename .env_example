# =============================================================================
#  Шаблон переменных окружения проекта SkillPort.
#
#  Скопируйте файл в .env и заполните значения:
#      Windows:      copy .env_example .env
#      Linux/macOS:  cp .env_example .env
#
#  ВАЖНО: файл .env в репозиторий не попадает (см. .gitignore) и в Docker-образ
#  не копируется (см. .dockerignore). Секреты храните только в .env и в
#  GitHub Secrets.
#
#  При запуске через docker compose значения POSTGRES_HOST и REDIS_HOST
#  заменяются на имена сервисов (db и redis) автоматически — см. docker-compose.yml.
#  Значения 127.0.0.1 ниже нужны для локального запуска без Docker
#  и для деплоя на сервер (venv + gunicorn + systemd).
# =============================================================================

# --- Django ---
# Обязательно. Сгенерировать новый ключ:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Режим отладки: True — только локально, False — на сервере
DEBUG=False

# Хосты, с которых разрешено обращаться к приложению (через запятую).
# Локально: localhost. На сервере: публичный IP или домен.
ALLOWED_HOSTS=localhost,127.0.0.1

# Источники, которым доверяем CSRF (нужны для входа в админку и Swagger).
# Формат — со схемой http:// или https://, через запятую.
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# --- PostgreSQL ---
POSTGRES_DB=skillport
POSTGRES_USER=skillport
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# --- Redis (брокер и result backend Celery) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# --- Email (уведомления подписчикам курсов) ---
# Если EMAIL_HOST_USER пустой — письма не отправляются, а печатаются в лог
# (удобно для локальной разработки). Для реальной отправки заполните оба поля:
# EMAIL_HOST_PASSWORD — это пароль приложения почты, а не пароль от аккаунта.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# --- Stripe (приём оплаты курсов) ---
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
